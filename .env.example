# Origen de los datos:
#   local    -> (por defecto) datos de ejemplo guardados en el navegador.
#               No necesita internet ni Firebase.
#   firebase -> usa Firebase Auth, Firestore y Storage con la configuración de abajo.
VITE_DATA_SOURCE=local

# Solo si VITE_DATA_SOURCE=firebase. Los valores están en la Consola de Firebase
# > Configuración del proyecto > Tus apps > SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
